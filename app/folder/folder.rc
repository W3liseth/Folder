#include <winres.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "folder.exe.manifest"

// Icône de l'application (sources : icon/folder.svg, icon/folder-small.svg ; cf. icon/make_ico.py).
// Ressource 1 : la première icône de l'exécutable, affichée par l'Explorateur et les raccourcis.
1 ICON "folder.ico"

// Nom affiché par Windows (Gestionnaire des tâches, propriétés du fichier).
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004
FILETYPE 0x1
{
  BLOCK "StringFileInfo"
  {
    BLOCK "040C04B0"
    {
      VALUE "FileDescription", "folder"
      VALUE "ProductName", "folder"
      VALUE "OriginalFilename", "folder.exe"
      VALUE "InternalName", "folder"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductVersion", "0.1.0"
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x040C, 1200
  }
}
