// Modèle : build.rs remplace @VERSION@ (0.3.0), @VERSION_COMMA@ (0,3,0,0) et @DIR@ (ce
// dossier) puis compile la copie complétée.
#include <winres.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@DIR@/folder.exe.manifest"

// Icône de l'application (source : icon/icone.png ; cf. icon/make_ico.ps1).
// Ressource 1 : la première icône de l'exécutable, affichée par l'Explorateur et les raccourcis.
1 ICON "@DIR@/folder.ico"

// Nom et version affichés par Windows (Gestionnaire des tâches, propriétés du fichier).
1 VERSIONINFO
FILEVERSION @VERSION_COMMA@
PRODUCTVERSION @VERSION_COMMA@
FILEOS 0x40004
FILETYPE 0x1
{
  BLOCK "StringFileInfo"
  {
    BLOCK "040C04B0"
    {
      VALUE "FileDescription", "folder"
      VALUE "ProductName", "folder"
      VALUE "OriginalFilename", "folder.exe"
      VALUE "InternalName", "folder"
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductVersion", "@VERSION@"
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x040C, 1200
  }
}
